# For Docker Compose. Plain Python does not load this file automatically.
# Copy to .env and fill locally; never commit .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
ADMIN_TOKEN=

# Локальная разработка ИИ-ядра через OpenRouter — та же модель, что на платформе
# (см. docs/AI-CORE.md). Пример значений:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen3.8-27b
# Эмбеддинги; Qwen3 Reranker на OpenRouter нет — пусто = без реранжирования.
EMB_MODEL=
RERANKER_MODEL=
