# Локальная разработка через OpenRouter (та же модель, что на платформе).
# Скопируйте в .env и подставьте свой ключ. .env в git не попадает.
# На платформе эти переменные задаёт организатор автоматически.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
EMB_MODEL=baai/bge-m3
# Реранкера Qwen3 Reranker на OpenRouter нет: пусто = поиск без реранжирования.
RERANKER_MODEL=
TEMPERATURE=0
MAX_TOKENS=1024
MAX_WORKERS=4
DATA_DIR=data/org
