# For Docker Compose. Plain Python does not load this file automatically.
# Copy to .env and fill locally; never commit .env.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
MAX_TOKENS=1200
ADMIN_TOKEN=

# Локальная разработка ИИ-ядра через OpenRouter — та же модель, что на платформе
# (см. docs/AI-CORE.md). Пример значений:
#   LLM_BASE_URL=https://openrouter.ai/api/v1
#   LLM_MODEL=qwen/qwen3.8-27b
# Бесплатный локальный веб-прогон (это не конкурсная модель):
#   LLM_MODEL=openrouter/free
#   MAX_TOKENS=4096
# Нужен отдельный ключ OpenRouter; для бесплатного демо выставьте ему лимит $0.
# Эмбеддинги; Qwen3 Reranker на OpenRouter нет — пусто = без реранжирования.
EMB_MODEL=
RERANKER_MODEL=
